server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index {{ nginx_static_site_index }};

{% for source in nginx_static_site_allowlist %}
    allow {{ source }};
{% endfor %}
    deny all;

    autoindex on;
    autoindex_localtime off;
    autoindex_exact_size off;
    server_tokens off;
    absolute_redirect off;
    disable_symlinks on from=$document_root;

    location = / {
        return 302 /{{ nginx_static_site_index }};
    }

{% if '/' in nginx_static_site_index %}
    location ~ ^/([^/]+\.html?)$ {
        return 302 /{{ nginx_static_site_index.rsplit('/', 1)[0] }}/$1;
    }
{% endif %}

    location ~ /\. {
        deny all;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
